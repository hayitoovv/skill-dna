# ==========================================
# SKILL DNA — Production Environment Settings
# ==========================================

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here_123
POSTGRES_DB=skill_dna

# Backend Secret (generate a strong random string)
SECRET_KEY=change_this_to_a_random_64_character_string_for_security

# Optional: Domain or Server IP
VITE_API_BASE=/api/v1

# ------------------------------------------
# Architecture v2.0 settings (backend/.env)
# ------------------------------------------
ENVIRONMENT=production
# Secret salt for ADAPT challenge variants (required in production): openssl rand -hex 32
CHALLENGE_SALT=change_this_to_a_random_hex_string

# AI layer: without a key, deterministic graders are used for viva, coach and planning
# LLM_PROVIDER: anthropic | gemini | empty (auto: whichever key is set, Anthropic first)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is overloaded (503), rate-limited (429) or retired (404)
GEMINI_FALLBACK_MODELS=

# Code sandbox: student code runs only in disposable Docker containers.
# Run it on a separate worker/sandbox host (section 3.5); never mount docker.sock into the API container.
SANDBOX_ENABLED=true
SANDBOX_PYTHON_IMAGE=python:3.12-alpine

# Open Badges 3.0 issuer (public key is served at /.well-known/did.json)
CREDENTIAL_ISSUER_DID=did:web:your-domain.uz
CREDENTIAL_VERIFY_BASE_URL=https://your-domain.uz/skilldna/api/v1/verify

# Job queue: with Redis the API hands sandbox runs and viva grading to the arq worker
# (deploy/skilldna-worker.service). Leave empty to run jobs inside the API process.
REDIS_URL=
# Two-factor auth is mandatory for moderator / university / super_admin roles when true
MFA_ENFORCED=true
